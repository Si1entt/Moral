# Copy values into your shell environment; .env files are not automatically loaded.
MODEL_PATH=meta-llama/Llama-3.1-8B-Instruct
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Each API command requires explicit model arguments. Paper roles:
# --generator-model (Gemini 3 Pro through an API-compatible provider)
# --attacker-model (Claude-3.5-Sonnet through an API-compatible provider)
# --judge-model (GPT-5 for moral classification; use the required safety judge explicitly)
